ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
PORT=3101
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional dev-only quick-login. Set both to enable a one-click "Dev quick-login"
# button on the sign-in screen. Only honored when `npm run dev` (import.meta.env.DEV).
# Stripped from production builds — never set these on a deployed env.
# VITE_DEV_LOGIN_EMAIL=you@example.com
# VITE_DEV_LOGIN_PASSWORD=changeme

# Optional dev-only pastor bypass. When 'true', POST /api/dev/become-pastor
# instantly turns the caller into a verified pastor of "Test Chapel". The button
# is also gated client-side on import.meta.env.DEV. NEVER set this in prod.
# DEV_PASTOR_BYPASS=true
